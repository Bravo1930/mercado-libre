# ==========================================
# ERP Mercado Libre México - Git Ignore
# ==========================================

# Entornos y Secretos
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/

# Python / uv
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/

# Pruebas y Cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.next/
out/
.turbo/

# Bases de datos y persistencia local
*.sqlite
*.sqlite3
*.db
postgres_data/
redis_data/
backups/
data/

# Almacenamiento dinámico de archivos (Etiquetas, reportes temporales)
storage/labels/*
!storage/labels/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/imports/*
!storage/imports/.gitkeep

# Logs del sistema
logs/
*.log
*.log.*
!logs/.gitkeep

# IDEs y Editores
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Docker / Tunnels
.docker/
*.pid
