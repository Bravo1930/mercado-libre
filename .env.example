# ==============================================================================
# ERP INTELIGENTE MERCADO LIBRE MÉXICO - VARIABLES DE ENTORNO (TEMPLATE)
# ==============================================================================
# IMPORTANTE: Nunca subas este archivo con credenciales reales a Git.
# Copia este archivo a '.env' para desarrollo local o configuración de servidor.

# ------------------------------------------------------------------------------
# 1. ENTORNO Y OPERACIÓN
# ------------------------------------------------------------------------------
# Entorno: 'development', 'testing', 'production'
ENVIRONMENT=development
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Formato de logs: 'console' (legible) o 'json' (producción / ingestores ELK/Loki)
LOG_FORMAT=console
# Host y Puerto del servicio API
API_HOST=0.0.0.0
API_PORT=8000
# Nombre de la instancia / Identificador de nodo
NODE_NAME=pc-dev-instance

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y ENCRIPTACIÓN (SAAS & TOKENS)
# ------------------------------------------------------------------------------
# Clave secreta para JWT de sesiones de usuario (Generar con: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_64_char_hex_secret_key_for_jwt_session_auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Clave AES-256 para encriptar los Refresh Tokens y Access Tokens de Mercado Libre en BD
# (Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=replace_with_fernet_aes_key_32_urlsafe_base64_encoded==

# Clave interna para comunicación segura entre microservicios / cron jobs / webhooks
INTERNAL_API_KEY=replace_with_secure_internal_service_key_for_cron_and_workers

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL 16 (CENTRAL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=meli_erp_db
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
# Pool de conexiones asíncronas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=30

# URL de conexión directa (se genera automáticamente a partir de los datos anteriores)
# DATABASE_URL=postgresql+asyncpg://erp_admin:password@postgres:5432/meli_erp_db

# ------------------------------------------------------------------------------
# 4. REDIS 7 (CACHE, LOCKS Y COLA DE WEBHOOKS)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# 5. INTEGRACIÓN MERCADO LIBRE MÉXICO (MLM)
# ------------------------------------------------------------------------------
# Obtenidos del Developer Portal de Mercado Libre: https://developers.mercadolibre.com.mx
MELI_APP_ID=replace_with_meli_app_id
MELI_CLIENT_SECRET=replace_with_meli_client_secret
# URL pública HTTPS donde Mercado Libre enviará el código de autorización OAuth
MELI_REDIRECT_URI=https://erp.tu-dominio.com/api/v1/auth/meli/callback
# URL pública HTTPS donde Mercado Libre enviará las notificaciones de webhooks
MELI_WEBHOOK_URL=https://erp.tu-dominio.com/api/v1/webhooks/meli

# Constantes oficiales de la API
MELI_API_BASE_URL=https://api.mercadolibre.com
MELI_AUTH_URL=https://auth.mercadolibre.com.mx/authorization
MELI_SITE_ID=MLM

# ------------------------------------------------------------------------------
# 6. INTEGRACIÓN GOOGLE SHEETS & EXCEL
# ------------------------------------------------------------------------------
# Ruta al archivo JSON de credenciales de la cuenta de servicio de Google Cloud
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/app/config/google_credentials.json

# ------------------------------------------------------------------------------
# 7. ALMACENAMIENTO Y RUTAS
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
STORAGE_LABELS_DIR=./storage/labels
STORAGE_EXPORTS_DIR=./storage/exports
STORAGE_IMPORTS_DIR=./storage/imports
LOGS_DIR=./logs
BACKUPS_DIR=./backups

# ------------------------------------------------------------------------------
# 8. CONFIGURACIÓN DEL SERVIDOR WEB Y DOMINIO (CADDY / SSL)
# ------------------------------------------------------------------------------
# Dominio para certificados SSL automáticos con Let's Encrypt
DOMAIN_NAME=erp.tu-dominio.com
ACME_EMAIL=admin@tu-dominio.com
